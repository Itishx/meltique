# ---------------------------------------------------------------------------
# Shopify
#
# The site runs without any of these: with no token set the Shopify layer
# stays dormant and the storefront behaves exactly as it does in pre-order
# mode. Fill these in to connect the store.
# ---------------------------------------------------------------------------

# Your store's permanent myshopify address. Not secret.
SHOPIFY_STORE_DOMAIN=5pxmtf-ni.myshopify.com

# Storefront API token. Read-only catalogue access plus cart creation.
#   Shopify admin -> Settings -> Apps and sales channels -> Shopify App Store
#   -> install "Headless" -> Create storefront -> copy the PRIVATE token.
# Used only on the server, never sent to the browser.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Fallback if you copied the public token instead. Either one works.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# ---------------------------------------------------------------------------
# Admin API token — scripts/shopify-sync.mjs only. NEVER read by the site.
#
# This one can change your live store, so keep it out of the browser and out
# of Vercel unless you intend to sync from there.
#   Shopify admin -> Settings -> Apps and sales channels -> Develop apps
#   -> Create an app -> Configure Admin API scopes -> write_products,
#      read_products -> Install -> reveal the Admin API access token (shpat_...)
# ---------------------------------------------------------------------------
SHOPIFY_ADMIN_TOKEN=

# Where Shopify should fetch product imagery from when syncing.
SHOPIFY_PUBLIC_ORIGIN=https://meltique.vercel.app
